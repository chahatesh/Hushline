{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hushline", "version": "0.1.0", "identifier": "io.chahatesh.hushline",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "Hushline", "width": 1180, "height": 800, "minWidth": 880, "minHeight": 640, "center": true, "visible": true },
      { "label": "overlay", "title": "Hushline dictation", "url": "index.html?overlay=1", "width": 360, "height": 90, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "focus": false, "focusable": false, "visible": false, "resizable": false, "shadow": false }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'" }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "category": "Productivity", "shortDescription": "Your words, wherever you work.",
    "longDescription": "Independent MIT-licensed Windows dictation with Groq speech recognition, local history, dictionary, snippets, and safe text insertion.",
    "copyright": "Copyright (c) 2026 Chahatesh", "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["English"], "installerHooks": "windows/hooks.nsh" } }
  }
}
